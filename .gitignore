# ==============================================================================
# SeaSentinel - .gitignore
# ==============================================================================

# Python Virtual Environments
.venv/
venv/
ENV/
env/
*.venv

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Operating System Temporary Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Settings
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Runtime Generated Caches & Past Job Runs
# (These are auto-generated dynamically on each execution)
data/cache/*
!data/cache/.gitkeep
data/jobs/*
!data/jobs/.gitkeep

# Local Scratchpad & Logs
*.log
scratch/
tmp/
temp/
